# QueryCraft environment configuration
# Copy to .env. Do not commit .env.

# llama.cpp OpenAI-compatible server
LLAMA_CPP_URL=http://127.0.0.1:8080/v1/chat/completions
LLAMA_CPP_MODEL=querycraft
LLAMA_CPP_TIMEOUT=60
LLAMA_CPP_MAX_TOKENS=256
LLAMA_CPP_TEMPERATURE=0.7
LLAMA_CPP_TOP_P=0.8
LLAMA_CPP_TOP_K=20
LLM_HISTORY_TURNS=12
LLM_MAX_TOOL_ROUNDS=5
LLM_AGENT_DEADLINE_SECONDS=30

# Whisper STT
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
WHISPER_BEAM_SIZE=1
WHISPER_INITIAL_PROMPT="QueryCraft. RSS. RSS feed. FreshRSS. MCP. web search. weather."

# Voice activity detection
SILENCE_THRESHOLD=0.015
SILENCE_SECONDS=1.5
MAX_RECORD_SECS=30
VAD_CALIBRATION_SECS=1.0
VAD_SPEECH_MULTIPLIER=3.0
VAD_MIN_SPEECH_SECS=0.4

# Kokoro TTS
KOKORO_VOICE_EN=af_heart
KOKORO_VOICE_JA=jf_alpha
KOKORO_VOICE_KO=kf_nayeon

# Default weather location
DEFAULT_LAT=51.4778
DEFAULT_LON=0.0015
DEFAULT_CITY=GREENWICH

# MCP
TOOL_OUTPUT_MAX_CHARS=8000

# FreshRSS
# Base URL. If FreshRSS shows a different Google Reader API address, use
# FRESHRSS_API_URL instead.
FRESHRSS_URL=http://127.0.0.1:8081
# FRESHRSS_API_URL=http://127.0.0.1:8081/api/greader.php
FRESHRSS_USER=admin
# This is the special API password configured in FreshRSS, NOT the API URL.
FRESHRSS_API_PASSWORD=replace_with_freshrss_api_password
RSS_FETCH_TIMEOUT=10
RSS_MAX_ITEMS=20
RSS_SNIPPET_MAX_CHARS=400

# Korean TTS
# auto: try MeloTTS first, then a local Windows ko-KR speech voice.
# melo: require MeloTTS. windows: require a Windows Korean speech voice.
KOREAN_TTS_BACKEND=auto
MELO_TTS_DEVICE=auto
MELO_TTS_SPEED=1.0
MELO_TTS_SPEAKER=KR
