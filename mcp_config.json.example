{
  "_comment": "MCP server registry. Copy to mcp_config.json. Secrets come from the project .env file.",
  "servers": [
    {
      "name": "documents",
      "command": "python",
      "args": ["agents/documents_agent.py"],
      "env": {
        "DOCUMENTS_ROOT": "~/Documents"
      },
      "enabled": true
    },
    {
      "name": "rss",
      "command": "python",
      "args": ["agents/rss_agent.py"],
      "env": {},
      "enabled": true
    },
    {
      "name": "code",
      "command": "python",
      "args": ["agents/code_agent.py"],
      "env": {},
      "enabled": false,
      "_comment": "Copy agents/agent_template.py to agents/code_agent.py and implement tools first."
    }
  ]
}
